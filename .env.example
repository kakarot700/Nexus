# Keep the deterministic demo as the default until a provider and model are intentionally configured.
NEXUS_AI_PROVIDER=demo

# Optional live provider credentials (server-side only; never use NEXT_PUBLIC_ prefixes).
# Select openai only after adding a key and model available to your API account.
# Set NEXUS_AI_PROVIDER=openai to activate live analysis and solution proposals.
OPENAI_API_KEY=
OPENAI_MODEL=
